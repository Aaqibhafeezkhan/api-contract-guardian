{
  "name": "api-contract-guardian",
  "displayName": "API Contract Guardian",
  "description": "Detect potentially breaking API contract changes in projects.",
  "version": "3.0.0",
  "icon": "images/icon.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.136.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "api-contract-guardian.scan",
        "title": "API Contract Guardian: Scan"
      }
    ]
  },
  "publisher": "komallsingh",
"repository": {
  "type": "git",
  "url": "https://github.com/komallsingh/api-contract-guardian.git"
},
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.136.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "pino": "^10.3.1"
  },
  "keywords": [
  "api",
  "api-contract",
  "breaking-changes",
  "express",
  "git",
  "developer-tools",
  "api-testing"
],
"galleryBanner": {
  "color": "#1f2937",
  "theme": "dark"
},
"pricing": "Free"
}
